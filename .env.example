# =====================================================================================
# MarketIntel environment configuration - PLACEHOLDER VALUES ONLY.
# Copy to `.env` (never commit `.env`). Broker API credentials are NOT set here: enter
# them in the admin panel (Data Provider Settings), where they are encrypted at rest.
# =====================================================================================

# --- Backend (FastAPI api + worker) --------------------------------------------------
ENVIRONMENT=development                 # development | test | production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Fernet key for encrypting provider credentials. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=
DATABASE_URL=postgresql+asyncpg://marketintel:marketintel@localhost:5432/marketintel
REDIS_URL=redis://localhost:6379/0
FRONTEND_ORIGIN=http://localhost:3000
# Optional: create the first admin automatically on first start (otherwise the first
# person to open the app creates the admin account).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
ALLOW_PUBLIC_REGISTRATION=false
# Run the worker loops inside the API process (single-service deployments).
RUN_WORKER_IN_API=false
# Development/testing only. Shows a permanent SIMULATED banner; never mixes with real data.
ALLOW_SIMULATED_FEED=false
EXPOSE_API_DOCS=
LOG_LEVEL=INFO

# --- AI (backend only - never exposed to the browser) ----------------------------------
ANTHROPIC_API_KEY=
AI_DEFAULT_MODEL=claude-opus-5-5

# --- Frontend (Next.js) --------------------------------------------------------------
# Server-side only: where the Next.js /api proxy forwards requests.
BACKEND_URL=http://localhost:8000
# Public WebSocket URL the browser connects to (served at runtime, not baked into the build).
PUBLIC_WS_URL=ws://localhost:8000/ws/stream
